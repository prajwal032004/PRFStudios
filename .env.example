# Copy to .env.local (or set in Vercel → Project → Settings → Environment Variables).
# All three are optional and public — they are compiled into the browser bundle. Never put secrets here.

# Enquiry form delivery. Without an endpoint the form falls back to opening the visitor's email app.
# Any service that accepts a JSON POST works, e.g.:
#   Formspree:  https://formspree.io/f/<form-id>
#   Web3Forms:  https://api.web3forms.com/submit   (also set the access key below)
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
NEXT_PUBLIC_ENQUIRY_ACCESS_KEY=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Without it no analytics script is loaded.
NEXT_PUBLIC_GA_ID=
